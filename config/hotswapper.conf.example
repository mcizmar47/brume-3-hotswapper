# Private router file: /root/hotswapper/hotswapper.conf, root-owned, mode 600.
# Discover these IDs from the selected route policy. Empty IDs fail closed.
TUNNEL_ID=''
GROUP_ID=''
NTFY_URL=''
# Required companion data: /root/hotswapper/hotswapper-locations.tsv and /root/hotswapper/reboot-guards.tsv.
# See ../docs/installer.md for the TSV contracts; only the new layout is supported.

# Detector: two failed 200 ms multi-target rounds; 150 ms after each pass.
# FAST_PROBE_WINDOW_US=200000
# FAST_FAILURE_THRESHOLD=2
# DETECTOR_DELAY_US=150000
