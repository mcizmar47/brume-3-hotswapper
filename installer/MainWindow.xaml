<Window x:Class="BrumeHotswapper.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrumeHotswapper.Installer"
        Title="Brume 3 Hotswapper" Width="1050" Height="790" MinWidth="910" MinHeight="680"
        Background="#F4F6F8" Foreground="#202A36" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <local:PageVisibilityConverter x:Key="Page"/>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <Style x:Key="SectionHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="SubtleText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#526173"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Padding" Value="19,9"/><Setter Property="MinWidth" Value="90"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
   <Setter Property="Background" Value="#225F77"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="110"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#B6C1CC"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#B6C1CC"/>
  </Style>
  <Style TargetType="Hyperlink">
   <Setter Property="Foreground" Value="#156C97"/>
  </Style>
  <Style x:Key="InfoBubble" TargetType="Border">
   <Setter Property="Background" Value="#E7EEF4"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
  </Style>
 </Window.Resources>

 <Grid Margin="26">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0" Margin="0,0,0,20">
   <DockPanel LastChildFill="False" Margin="0,0,0,5">
    <TextBlock Text="BRUME 3 HOTSWAPPER" Foreground="#225F77" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left"/>
    <TextBlock Text="{Binding ModeLabel}" Foreground="#677487" FontSize="12" DockPanel.Dock="Right"/>
   </DockPanel>
   <TextBlock Text="{Binding StepLabel}" Foreground="#657588" FontSize="12" Margin="0,3,0,3"/>
   <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="30"/>
  </StackPanel>

  <Border Grid.Row="1" Background="White" CornerRadius="9" BorderBrush="#DEE5EB" BorderThickness="1" Padding="26">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- 1: PREREQUISITES -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=0}">
     <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Check hardware and software" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="This tool is designed for GL.iNet Brume 3 (GL-MT5000)." Margin="0,0,0,7"/>
      <TextBlock Margin="0,0,0,7" TextWrapping="Wrap">
       <Run Text="Currently verified firmware versions: "/><Run Text="{Binding SupportedVersions, Mode=OneWay}" FontWeight="SemiBold"/>
      </TextBlock>
      <TextBlock TextWrapping="Wrap"><Run Text="If your router is on an older version, update it through the "/><Hyperlink NavigateUri="http://192.168.8.1/#/upgrade" RequestNavigate="OpenLink">Admin Panel</Hyperlink><Run Text=" or "/><Hyperlink NavigateUri="https://dl.gl-inet.com/router/mt5000/stable" RequestNavigate="OpenLink">download a specific compatible firmware version</Hyperlink><Run Text="."/></TextBlock>

      <Separator Margin="0,25,0,24"/>
      <TextBlock Text="Make sure your VPN profiles are set up" Style="{StaticResource SectionHeading}"/>
      <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run Text="Go to: "/><Hyperlink NavigateUri="http://192.168.8.1/#/vpn-client" RequestNavigate="OpenLink">GL.iNet Admin Panel &gt; VPN &gt; VPN Client Profile</Hyperlink></TextBlock>
      <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">NOTE: You don't need to sort individual connections in the GL.iNet Admin Panel. Hotswapper uses the priorities you set here.</TextBlock>
      <TextBlock TextWrapping="Wrap"><Run Text="Create at least one VPN tunnel in "/><Hyperlink NavigateUri="http://192.168.8.1/#/vpndashboard" RequestNavigate="OpenLink">GL.iNet Admin Panel &gt; VPN &gt; VPN Dashboard</Hyperlink><Run Text=". Include connections to at least two different geographic locations."/></TextBlock>

      <Separator Margin="0,25,0,24"/>
      <TextBlock Text="Disable auto-update" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Disable automatic firmware updates on the router. An update could break Hotswapper's GL.iNet integration." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="Before updating the router firmware, uninstall Hotswapper. This version does not include a one-click uninstaller." TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>

    <!-- 2.1: CONNECT -->
    <StackPanel Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=1}" MaxWidth="550" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsVisibleChanged="ConnectPageVisibilityChanged">
     <TextBlock Text="Connect to the Brume 3 router using its local address and admin password." TextWrapping="Wrap" Margin="0,0,0,22"/>
     <TextBlock Text="Router address" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBox Text="{Binding RouterAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDisconnected}" Margin="0,0,0,21" Width="420" HorizontalAlignment="Left"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
      <TextBlock Text="Admin password" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <Border Style="{StaticResource InfoBubble}" ToolTip="Your router admin password, not the Wi-Fi password." ToolTipService.InitialShowDelay="0">
       <TextBlock Text="?" FontWeight="SemiBold" Foreground="#225F77" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </StackPanel>
     <PasswordBox x:Name="RouterPassword" Width="420" HorizontalAlignment="Left" IsEnabled="{Binding IsDisconnected}"/>
     <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource SubtleText}" Margin="0,21,0,0"/>
    </StackPanel>

    <!-- 2.2: COMPATIBILITY (only shown when the connection needs attention) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=2}">
     <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="{Binding CompatibilityHeadline}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,17" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding CompatibilityDescription}" TextWrapping="Wrap" Margin="0,0,0,15"/>
      <StackPanel Visibility="{Binding ShowVpnHelp, Converter={StaticResource Bool}}" Margin="0,3,0,20">
       <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"><Run Text="Set up VPN profiles: "/><Hyperlink NavigateUri="http://192.168.8.1/#/vpn-client" RequestNavigate="OpenLink">GL.iNet Admin Panel &gt; VPN &gt; VPN Client Profile</Hyperlink></TextBlock>
       <TextBlock TextWrapping="Wrap"><Run Text="Then create and activate a tunnel: "/><Hyperlink NavigateUri="http://192.168.8.1/#/vpndashboard" RequestNavigate="OpenLink">GL.iNet Admin Panel &gt; VPN &gt; VPN Dashboard</Hyperlink></TextBlock>
       <TextBlock Text="You don't need to sort individual connection preferences in the Admin Panel; Hotswapper uses the tier order you set here." Margin="0,9,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowFirmwareHelp, Converter={StaticResource Bool}}" Margin="0,3,0,20">
       <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="Verified versions: "/><Run Text="{Binding SupportedVersions, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
       <TextBlock TextWrapping="Wrap"><Run Text="Update from the "/><Hyperlink NavigateUri="http://192.168.8.1/#/upgrade" RequestNavigate="OpenLink">Admin Panel</Hyperlink><Run Text=" or "/><Hyperlink NavigateUri="https://dl.gl-inet.com/router/mt5000/stable" RequestNavigate="OpenLink">download a compatible firmware image</Hyperlink><Run Text="."/></TextBlock>
      </StackPanel>
      <CheckBox IsChecked="{Binding AcceptUnsupportedFirmware}" Visibility="{Binding ShowFirmwareOverride, Converter={StaticResource Bool}}" Margin="0,15,0,0" Content="I wish to proceed with installation on an unsupported firmware version."/>
      <TextBlock Text="This only overrides the version check. If any required system file differs from the supported layout, installation will still stop before making changes." Style="{StaticResource SubtleText}" Margin="0,8,0,0" Visibility="{Binding ShowFirmwareOverride, Converter={StaticResource Bool}}"/>
     </StackPanel>
    </ScrollViewer>

    <!-- 3: CONFIGURE TIERS -->
    <Grid Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=3}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Tier 1: "/>Preferred connections.</TextBlock>
      <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Tier 2: "/>Secondary preferred connections. After a downgrade from Tier 1, the router waits until the daily maintenance reboot to try returning to Tier 1.</TextBlock>
      <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Tier 3: "/>Backup connections. The router actively attempts to return to Tier 1 or Tier 2.</TextBlock>
     </StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="VPN tunnel:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
      <ComboBox ItemsSource="{Binding EligibleProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Display" Width="400" Padding="8,5"/>
     </StackPanel>
     <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiers}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#F4F6F8" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="6" Margin="4" Padding="9">
        <DockPanel LastChildFill="True">
         <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,12" FontSize="13" TextWrapping="Wrap"/>
         <ListBox ItemsSource="{Binding Locations}" Background="Transparent" BorderThickness="0" AllowDrop="True" MinHeight="200"
                  PreviewMouseLeftButtonDown="CardMouseDown" PreviewMouseMove="CardMouseMove" Drop="CardDrop" DragOver="CardDragOver"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D5DFE8" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,3">
           <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding CountLabel}" FontSize="12" Foreground="#657488"/></StackPanel>
          </Border></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
        </DockPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Grid>

    <!-- 4: TIER 1 RECOVERY -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=4}">
     <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Enter when the router may reboot." FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="To minimize downtime, recovery from Tier 2 to Tier 1 is scheduled around a daily maintenance reboot. The router attempts recovery before rebooting." TextWrapping="Wrap" Margin="0,0,0,20"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
       <TextBlock Text="Attempt reboot from:" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <TextBox Text="{Binding RebootStartText, UpdateSourceTrigger=PropertyChanged}" Width="48" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="HourInput" DataObject.Pasting="HourPaste"/>
       <TextBlock Text="to" VerticalAlignment="Center" Margin="12,0"/>
       <TextBox Text="{Binding RebootEndText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasGuards}" Width="48" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="HourInput" DataObject.Pasting="HourPaste"/>
       <Border Style="{StaticResource InfoBubble}" Margin="12,0,0,0" ToolTipService.InitialShowDelay="0" ToolTip="24-hour format: 00-23 (for example, 2 PM = 14). With no protected devices, the router attempts one reboot at the first hour.">
        <TextBlock Text="?" Foreground="#225F77" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </StackPanel>
      <TextBlock Text="Devices that block a reboot" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="During the selected time window, the router checks whether any protected device is online. If one is detected, reboot is postponed." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="Each device must already have a reserved IP address. Add or check reservations "/><Hyperlink NavigateUri="http://192.168.8.1/#/lanip" RequestNavigate="OpenLink">here</Hyperlink><Run Text=" (Address Reservation, using the device's MAC address)."/></TextBlock>
      <TextBlock Text="If you just added a reservation, go Back and then Continue to refresh the router's address list." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="Avoid always-on devices such as phones and servers: they could prevent every reboot." TextWrapping="Wrap" Margin="0,0,0,17"/>
      <Border BorderBrush="#DFE6EC" BorderThickness="1" CornerRadius="5" Padding="12" MaxWidth="660" HorizontalAlignment="Left">
       <StackPanel>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="Reserved device IPv4 address" FontWeight="SemiBold" VerticalAlignment="Center"/>
         <Button Grid.Column="1" Content="+ Add IP" Command="{Binding AddGuardCommand}" Padding="12,6"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding GuardEntries}">
         <ItemsControl.ItemTemplate><DataTemplate><DockPanel LastChildFill="True" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="-" ToolTip="Remove this address" ToolTipService.InitialShowDelay="0" Click="RemoveGuard" Tag="{Binding}" Margin="10,0,0,0" Padding="12,4"/>
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="9,5"/>
         </DockPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding GuardHint}" Style="{StaticResource SubtleText}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <!-- 5: INSTALLATION -->
    <Grid Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=5}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding InstallationHeadline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <ProgressBar Grid.Row="1" Height="6" IsIndeterminate="{Binding Busy}" Margin="0,0,0,18"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Progress}">
       <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Visibility="{Binding HasErrorMessage, Converter={StaticResource Bool}}" Foreground="#A52722" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2" MinHeight="43" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Back" Command="{Binding BackCommand}" Visibility="{Binding ShowBack, Converter={StaticResource Bool}}" Style="{StaticResource NavButton}"/>
    <Button Content="Cancel" Click="CloseInstaller" Visibility="{Binding ShowCancel, Converter={StaticResource Bool}}" Style="{StaticResource NavButton}"/>
    <TextBlock Visibility="{Binding ShowSaveLog, Converter={StaticResource Bool}}" VerticalAlignment="Center">
     <Hyperlink Click="SaveInstallationLog">Save Installation Log</Hyperlink>
    </TextBlock>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="{Binding ConnectionButtonLabel}" Click="ToggleConnection" IsEnabled="{Binding CanToggleConnection}" Style="{StaticResource NavButton}" Visibility="{Binding ShowConnect, Converter={StaticResource Bool}}" Margin="0,0,12,0"/>
    <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding ShowPrimary, Converter={StaticResource Bool}}"/>
    <Button Content="Close" Click="CloseInstaller" IsEnabled="{Binding Idle}" Style="{StaticResource PrimaryButton}" Visibility="{Binding ShowSaveLog, Converter={StaticResource Bool}}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>

